# 统一换行符，避免跨平台检出时产生无意义的差异
* text=auto

# 源码与文档统一以 LF 入库
*.html   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.js     text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# 二进制文件不做任何换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary

# three.js 压缩产物：避免 diff 与语言统计干扰
vendor/three.min.js  linguist-vendored
